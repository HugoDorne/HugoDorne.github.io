---
/**
 * Shared inline SVG icons — keeps the GitHub / LinkedIn / mail marks in one
 * place instead of copy-pasted across the footer, the hero and project cards.
 */
import type { IconName } from "./icons";

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = "h-4 w-4" } = Astro.props;

// Brand marks are solid paths, UI glyphs are stroked.
const isBrand = name === "github" || name === "gitlab" || name === "linkedin";
---

{
	isBrand ? (
		<svg class={className} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
			{name === "github" && (
				<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
			)}
			{name === "gitlab" && (
				<path d="M12 21.42 15.68 10.1H8.32L12 21.42ZM3.16 10.1 12 21.42 1.5 13.79a.84.84 0 0 1-.3-.94l1.96-2.75Zm0 0h5.16L4.64 2.6a.42.42 0 0 0-.8 0L3.16 10.1Zm17.68 0L12 21.42l10.5-7.63a.84.84 0 0 0 .3-.94l-1.96-2.75Zm0 0h-5.16L19.36 2.6a.42.42 0 0 1 .8 0l.68 7.5Z" />
			)}
			{name === "linkedin" && (
				<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
			)}
		</svg>
	) : (
		<svg
			class={className}
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			{name === "globe" && (
				<>
					<circle cx="12" cy="12" r="9" />
					<path d="M3.6 9h16.8M3.6 15h16.8" />
					<path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z" />
				</>
			)}
			{name === "email" && (
				<path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
			)}
			{name === "download" && (
				<path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
			)}
			{name === "external" && (
				<path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
			)}
		</svg>
	)
}
