---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { languages, type Lang } from "../i18n/ui";
import { getLangFromUrl, localizePath, switchLocalePath, useTranslations } from "../i18n/utils";
import { getCv } from "../data/cv";

interface Props {
	title: string;
	description?: string;
	favicon?: string;
	image?: string;
	/** Keep the page out of search results — also excluded from the sitemap in astro.config.mjs. */
	noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { about, experiences, education, skillCategories, languages: spokenLanguages } = getCv(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description = t("home.description"), favicon = "👨‍💻", image = "/og.png", noindex = false } = Astro.props;
const imageURL = new URL(image, Astro.site);

// Same page in every locale, so search engines can pair them up.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
	code,
	href: new URL(switchLocalePath(Astro.url, code), Astro.site).toString(),
}));

/*
 * One Person entity for the whole site, referenced by @id from every page
 * rather than repeated, so search engines resolve it to a single identity.
 * The homepage additionally declares itself as that person's ProfilePage.
 * Deliberately no email: it is already a mailto link on the page, and there is
 * no reason to hand it to scrapers in machine-readable form as well.
 */
const siteUrl = Astro.site?.toString() ?? "";
const personId = `${siteUrl}#person`;
const currentRole = experiences[0];
const isProfilePage = Astro.url.pathname.replace(/\/$/, "") === localizePath("/", lang).replace(/\/$/, "");

const person = {
	"@type": "Person",
	"@id": personId,
	name: about.name,
	jobTitle: about.title,
	description: about.summary.replace(/\n/g, " "),
	url: new URL(localizePath("/", lang), Astro.site).toString(),
	image: new URL("/og.png", Astro.site).toString(),
	address: {
		"@type": "PostalAddress",
		addressLocality: "Sophia Antipolis",
		addressRegion: "Provence-Alpes-Côte d'Azur",
		addressCountry: "FR",
	},
	sameAs: [about.github, about.linkedin],
	knowsAbout: skillCategories.flatMap((category) => category.skills),
	knowsLanguage: spokenLanguages.map((entry) => entry.name),
	alumniOf: education.map((entry) => ({
		"@type": "CollegeOrUniversity",
		name: entry.institution,
		...(entry.url ? { url: entry.url } : {}),
	})),
	...(currentRole
		? {
				worksFor: {
					"@type": "Organization",
					name: currentRole.company,
					...(currentRole.companyUrl ? { url: currentRole.companyUrl } : {}),
				},
			}
		: {}),
};

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}#website`,
			url: siteUrl,
			name: about.name,
			inLanguage: languages[lang].htmlLang,
			publisher: { "@id": personId },
		},
		person,
		...(isProfilePage
			? [
					{
						"@type": "ProfilePage",
						"@id": canonicalURL.toString(),
						url: canonicalURL.toString(),
						name: title,
						inLanguage: languages[lang].htmlLang,
						isPartOf: { "@id": `${siteUrl}#website` },
						about: { "@id": personId },
						mainEntity: { "@id": personId },
					},
				]
			: []),
	],
};
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="dns-prefetch" href="https://maps.google.com" />
		<link rel="canonical" href={canonicalURL} />
		{!noindex && alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
		{!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />}
		<link
			rel="icon"
			href={`data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%2210 0 100 100%22><text y=%22.90em%22 font-size=%2290%22>${favicon}</text></svg>`}
		/>
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${about.name} — ${about.title}`} />
		<meta property="og:site_name" content="Hugo Dorne" />
		<meta property="og:locale" content={languages[lang].ogLocale} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<!-- JSON-LD Structured Data -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<ClientRouter />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col font-sans antialiased">
		<slot />
	</body>
</html>
