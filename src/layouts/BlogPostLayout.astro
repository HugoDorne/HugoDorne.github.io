---
import PageLayout from "./PageLayout.astro";
import { formatDate, getLangFromUrl, localizePath, useTranslations } from "../i18n/utils";

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
}

const { title, description, pubDate, updatedDate } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const formattedDate = formatDate(pubDate, lang);
const formattedUpdated = updatedDate && formatDate(updatedDate, lang);
---

<PageLayout title={`${title} — Hugo Dorne`} description={description} favicon="📖">
	<article class="py-20">
		<div class="mx-auto max-w-3xl px-4 sm:px-6">
			<a href={localizePath("/blog", lang)} class="text-sm text-zinc-500 transition-colors hover:text-orange-400"
				>&larr; {t("blog.back")}</a
			>

			<header class="mt-6">
				<time class="text-sm text-zinc-500">{formattedDate}</time>
				{
					formattedUpdated && (
						<span class="text-sm text-zinc-600">
							{" "}
							({t("blog.updated")} {formattedUpdated})
						</span>
					)
				}
				<h1 class="mt-3 text-3xl font-bold text-zinc-50 md:text-4xl">{title}</h1>
				<p class="mt-3 text-lg text-zinc-400">{description}</p>
			</header>

			<div
				class="prose mt-10 max-w-none prose-invert prose-orange prose-headings:text-zinc-50 prose-p:text-zinc-400 prose-a:text-orange-400 prose-strong:text-zinc-300 prose-code:text-orange-300 prose-pre:border prose-pre:border-zinc-800 prose-pre:bg-zinc-900"
			>
				<slot />
			</div>
		</div>
	</article>
</PageLayout>
