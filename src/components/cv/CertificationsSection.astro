---
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import { certifications } from "../../data/cv";
---

<section id="certifications" class="animate-on-scroll py-16">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<SectionHeading title="Certifications" />
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				certifications.map((cert) => {
					// Only render a link when there is somewhere to go — an <a> without
					// href is not focusable and reads as a broken control.
					const Wrapper = cert.url ? "a" : "div";
					return (
					<Wrapper
						href={cert.url}
						target={cert.url ? "_blank" : undefined}
						rel={cert.url ? "noopener noreferrer" : undefined}
						aria-label={cert.url ? `View ${cert.name} certification from ${cert.issuer}` : undefined}
						class={`group block rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 transition-all duration-300 ${cert.url ? "hover:-translate-y-0.5 hover:border-orange-400/30 cursor-pointer" : ""}`}
					>
						<div class="flex items-center justify-between">
							<h3 class="text-base font-semibold text-zinc-50 group-hover:text-orange-400 transition-colors">{cert.name}</h3>
							{cert.url && (
								<Icon name="external" class="h-4 w-4 text-zinc-600 transition-colors group-hover:text-orange-400" />
							)}
						</div>
						<p class="mt-1 text-sm text-zinc-500">
							{cert.issuer} — {cert.year}
						</p>
					</Wrapper>
					);
				})
			}
		</div>
	</div>
</section>
