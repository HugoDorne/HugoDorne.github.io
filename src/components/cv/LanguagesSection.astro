---
import SectionHeading from "../ui/SectionHeading.astro";
import { getCv } from "../../data/cv";
import type { Proficiency } from "../../data/models";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { languages } = getCv(lang);

// Keyed on the normalised proficiency, never on the translated label.
const levelWidths: Record<Proficiency, string> = {
	native: "w-full",
	fluent: "w-5/6",
	intermediate: "w-3/5",
	beginner: "w-2/5",
	notions: "w-1/5",
};
---

<section id="languages" class="animate-on-scroll py-16">
	<div class="container-page">
		<SectionHeading title={t("section.languages")} />
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				languages.map((entry) => (
					<div class="group rounded-xl border border-zinc-800 bg-zinc-900/50 p-5">
						<div class="flex items-baseline justify-between">
							<div class="flex items-baseline gap-2">
								<h3 class="text-base font-semibold text-zinc-50">{entry.name}</h3>
								<span class="text-xs text-orange-400/70 italic opacity-0 transition-opacity duration-300 group-hover:opacity-100">
									{entry.hello}
								</span>
							</div>
							<span class="text-sm text-zinc-500">
								{entry.level}
								{entry.details && ` (${entry.details})`}
							</span>
						</div>
						<div class="mt-3 h-1.5 w-full rounded-full bg-zinc-800">
							<div class:list={["h-1.5 rounded-full bg-orange-400", levelWidths[entry.proficiency]]} />
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
