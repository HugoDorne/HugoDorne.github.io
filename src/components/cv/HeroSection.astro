---
import { Image } from "astro:assets";
import { getCv } from "../../data/cv";
import Icon from "../ui/Icon.astro";
import mePhoto from "../../assets/me.webp";
import { funTitles, golfTitleIndices, languages } from "../../i18n/ui";
import { getLangFromUrl, localizePath, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { about } = getCv(lang);
---

<!-- Tighter below than above: the hero should read as flowing into the first section. -->
<section id="about" class="animate-on-scroll pt-20 pb-10 md:pt-28 md:pb-12">
	<div class="container-page">
		<div class="flex flex-col items-center gap-10 md:flex-row md:gap-16">
			<!-- Photo -->
			<div class="flex-shrink-0">
				<div class="relative">
					<div
						class="absolute -inset-2 rounded-full bg-gradient-to-br from-orange-400/40 to-orange-600/20 blur-md"
					>
					</div>
					<Image
						src={mePhoto}
						alt={about.name}
						widths={[192, 224, 384, 448]}
						sizes="(min-width: 768px) 224px, 192px"
						loading="eager"
						class="relative h-48 w-48 rounded-full border-2 border-zinc-800 object-cover md:h-56 md:w-56"
					/>
				</div>
			</div>

			<!-- Info -->
			<div class="text-center md:text-left">
				<h1 class="text-4xl font-bold text-zinc-50 md:text-5xl lg:text-6xl">{about.name}</h1>
				<p
					id="hero-title"
					class="mt-3 cursor-default text-xl text-balance text-orange-400 md:text-2xl"
					data-titles={JSON.stringify(funTitles[lang])}
					data-golf-indices={JSON.stringify(golfTitleIndices)}
					data-golf-href={localizePath("/golf", lang)}
				>
					<span id="hero-title-text">{about.title}</span>
				</p>
				<a
					href="https://maps.google.com/?q=Sophia+Antipolis,+France"
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`${about.location} ${t("hero.viewMap")}`}
					class="mt-2 inline-flex items-center gap-1.5 text-base text-zinc-500 transition-colors hover:text-orange-400"
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
						><path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
						></path><path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
					>
					{about.location}
					<Icon name="external" class="h-3 w-3 text-zinc-600" />
				</a>
				<p class="mt-4 max-w-lg text-base text-zinc-400">
					{
						about.summary.split("\n").map((line, i) => (
							<>
								{i > 0 && <br />}
								{line}
							</>
						))
					}
				</p>

				<!-- Social links -->
				<div class="mt-6 flex items-stretch justify-center gap-4 md:justify-start">
					<a
						href={about.github}
						target="_blank"
						rel="noopener noreferrer"
						class="flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-orange-400/40 hover:text-orange-400"
						aria-label={t("hero.github")}
					>
						<Icon name="github" class="h-5 w-5" />
					</a>
					<a
						href={about.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-orange-400/40 hover:text-orange-400"
						aria-label={t("hero.linkedin")}
					>
						<Icon name="linkedin" class="h-5 w-5" />
					</a>
					<a
						href={`mailto:${about.email}`}
						class="flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 transition-colors hover:border-orange-400/40 hover:text-orange-400"
						aria-label={t("hero.email")}
					>
						<Icon name="email" class="h-5 w-5" />
					</a>
					<!-- Primary action: orange at rest so it reads as the call to action. -->
					<a
						href={languages[lang].cvFile}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center gap-2 rounded-lg border border-orange-400/40 bg-orange-400/5 px-4 text-sm font-medium text-orange-400 transition-colors hover:border-orange-400 hover:bg-orange-400/15 hover:text-orange-300"
						aria-label={t("hero.cvLabel")}
					>
						<Icon name="document" class="h-5 w-5" />
						{t("hero.cv")}
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// Hero-only easter eggs: they target #hero-title / #about img, which exist
	// on the home page alone, so they ship with the hero rather than the layout.
	// The titles come from data attributes so this script stays locale-agnostic
	// and can still be bundled and minified.
	const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	function initTitleCycler() {
		const titleEl = document.getElementById("hero-title-text");
		const parent = document.getElementById("hero-title");
		if (!titleEl || !parent) return;

		const titles: string[] = JSON.parse(parent.dataset.titles || "[]");
		const golfIndices = new Set<number>(JSON.parse(parent.dataset.golfIndices || "[]"));
		const golfHref = parent.dataset.golfHref || "/golf";
		if (titles.length === 0) return;

		const original = titleEl.textContent || "";
		let lastIndex = -1;

		parent.addEventListener("mouseenter", () => {
			let idx;
			do {
				idx = Math.floor(Math.random() * titles.length);
			} while (idx === lastIndex);
			lastIndex = idx;
			titleEl.textContent = titles[idx]!;
			if (golfIndices.has(idx)) {
				titleEl.style.textDecoration = "underline";
				titleEl.style.cursor = "pointer";
				titleEl.onclick = () => (window.location.href = golfHref);
			} else {
				titleEl.style.textDecoration = "";
				titleEl.style.cursor = "";
				titleEl.onclick = null;
			}
		});
		parent.addEventListener("mouseleave", () => {
			titleEl.textContent = original;
			titleEl.style.textDecoration = "";
			titleEl.style.cursor = "";
			titleEl.onclick = null;
		});
	}

	initTitleCycler();
	document.addEventListener("astro:after-swap", initTitleCycler);

	// Sparkle cursor trail — 10 rapid clicks on photo
	function sparkleExplosion(x: number, y: number) {
		const colors = ["#fb923c", "#fbbf24", "#f59e0b", "#ffffff", "#D97757", "#ef4444"];
		for (let i = 0; i < 40; i++) {
			const particle = document.createElement("div");
			const size = 4 + Math.random() * 10;
			const angle = (Math.PI * 2 * i) / 40 + (Math.random() - 0.5) * 0.5;
			const distance = 40 + Math.random() * 80;
			const dx = Math.cos(angle) * distance;
			const dy = Math.sin(angle) * distance;
			particle.style.cssText = `
				position:fixed;z-index:9999;pointer-events:none;
				width:${size}px;height:${size}px;border-radius:50%;
				background:${colors[Math.floor(Math.random() * colors.length)]};
				left:${x - size / 2}px;top:${y - size / 2}px;
				box-shadow:0 0 ${size * 2}px ${colors[Math.floor(Math.random() * colors.length)]};
			`;
			document.body.appendChild(particle);
			particle.animate(
				[
					{ transform: "scale(1)", opacity: 1 },
					{ transform: `scale(0) translate(${dx}px, ${dy}px)`, opacity: 0 },
				],
				{ duration: 600 + Math.random() * 400, easing: "cubic-bezier(0, 0.5, 0.5, 1)" }
			).onfinish = () => particle.remove();
		}
		// Flash ring
		const ring = document.createElement("div");
		ring.style.cssText = `
			position:fixed;z-index:9998;pointer-events:none;
			width:20px;height:20px;border-radius:50%;
			left:${x - 10}px;top:${y - 10}px;
			border:2px solid #fb923c;
		`;
		document.body.appendChild(ring);
		ring.animate(
			[
				{ transform: "scale(1)", opacity: 1 },
				{ transform: "scale(8)", opacity: 0 },
			],
			{ duration: 500, easing: "ease-out" }
		).onfinish = () => ring.remove();
	}

	let sparkleActive = false;
	function initSparkleTrail() {
		const photo = document.querySelector("#about img, #about picture img");
		if (!photo) return;
		let clicks: number[] = [];

		photo.addEventListener("click", (e) => {
			if (prefersReducedMotion()) return;
			e.preventDefault();
			const now = Date.now();
			clicks.push(now);
			clicks = clicks.filter((time) => now - time < 5000);
			if (clicks.length >= 10 && !sparkleActive) {
				sparkleActive = true;
				const me = e as MouseEvent;
				sparkleExplosion(me.clientX, me.clientY);
				document.addEventListener("mousemove", sparkleTrail);
				setTimeout(() => {
					sparkleActive = false;
					document.removeEventListener("mousemove", sparkleTrail);
				}, 8000);
				clicks = [];
			}
		});
	}

	function sparkleTrail(e: MouseEvent) {
		const sparkle = document.createElement("div");
		const size = 4 + Math.random() * 8;
		const colors = ["#fb923c", "#fbbf24", "#f59e0b", "#ffffff", "#D97757"];
		sparkle.style.cssText = `
			position:fixed;z-index:9999;pointer-events:none;
			width:${size}px;height:${size}px;border-radius:50%;
			background:${colors[Math.floor(Math.random() * colors.length)]};
			left:${e.clientX - size / 2}px;top:${e.clientY - size / 2}px;
			box-shadow:0 0 ${size}px ${colors[Math.floor(Math.random() * colors.length)]};
		`;
		document.body.appendChild(sparkle);
		sparkle.animate(
			[
				{ transform: "scale(1) translateY(0)", opacity: 1 },
				{
					transform: `scale(0) translateY(${-20 - Math.random() * 30}px) translateX(${(Math.random() - 0.5) * 40}px)`,
					opacity: 0,
				},
			],
			{ duration: 500 + Math.random() * 500 }
		).onfinish = () => sparkle.remove();
	}

	initSparkleTrail();
	document.addEventListener("astro:after-swap", initSparkleTrail);
</script>
