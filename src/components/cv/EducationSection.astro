---
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import { getCv } from "../../data/cv";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { education } = getCv(lang);
---

<section id="education" class="animate-on-scroll py-16">
	<div class="container-page">
		<SectionHeading title={t("section.education")} />
		<div class="ml-1">
			{
				education.map((edu) => (
					<div class="relative pb-10 pl-8 last:pb-0">
						<div class="absolute top-2 bottom-0 left-0 w-px bg-zinc-800" />
						<div class="absolute top-2 left-0 h-3 w-3 -translate-x-1/2 rounded-full border-2 border-orange-400 bg-zinc-950" />
						<div>
							{edu.url ? (
								<a
									href={edu.url}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${t("education.visit")} ${edu.institution} ${t("education.website")}`.trim()}
									class="inline-flex items-center gap-1 text-lg font-semibold text-zinc-50 transition-colors hover:text-orange-400"
								>
									{edu.institution}
									<Icon name="external" class="h-3.5 w-3.5 text-zinc-600" />
								</a>
							) : (
								<h3 class="text-lg font-semibold text-zinc-50">{edu.institution}</h3>
							)}
							<p class="mt-1 text-sm font-medium text-orange-400">{edu.degree}</p>
							<p class="mt-0.5 text-sm text-zinc-500">
								{edu.startYear} — {edu.endYear}
							</p>
							{edu.details && (
								<p
									class={`mt-2 text-sm ${edu.isAward ? "font-medium text-zinc-300" : "text-zinc-400"}`}
								>
									{edu.detailsUrl ? (
										<a
											href={edu.detailsUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1 transition-colors hover:text-orange-400"
										>
											{edu.details}
											<Icon name="external" class="h-3 w-3 text-zinc-600" />
										</a>
									) : (
										edu.details
									)}
								</p>
							)}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
