---
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectCard from "../ProjectCard.astro";
import { projects } from "../../data/projects";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<PageLayout title={t("projects.pageTitle")} favicon="🚀">
	<section class="py-20">
		<div class="container-page">
			<h1 class="text-3xl font-bold text-zinc-50 md:text-4xl">{t("projects.title")}</h1>
			<p class="mt-3 text-base text-zinc-400">{t("projects.intro")}</p>

			<div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>

			<p class="mt-12 text-center text-lg text-zinc-500 italic">{t("projects.more")}</p>
		</div>
	</section>
</PageLayout>
