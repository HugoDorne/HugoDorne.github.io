---
import PageLayout from "../../layouts/PageLayout.astro";
import BlogPostCard from "../BlogPostCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));

const posts = (await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageLayout title={t("blog.pageTitle")} favicon="📖">
	<section class="py-20">
		<div class="container-page">
			<h1 class="text-3xl font-bold text-zinc-50 md:text-4xl">{t("blog.title")}</h1>
			<p class="mt-3 text-base text-zinc-400">{t("blog.intro")}</p>

			{
				posts.length === 0 ? (
					<div class="mt-20 flex flex-col items-center text-center">
						<p class="text-5xl" aria-hidden="true">
							🚧
						</p>
						<p class="mt-4 text-xl text-zinc-400">{t("blog.empty")}</p>
						<p class="mt-2 text-sm text-zinc-500">{t("blog.emptyHint")}</p>
					</div>
				) : (
					<div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
						{posts.map((post) => (
							<BlogPostCard
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								tags={post.data.tags}
								slug={post.id}
							/>
						))}
					</div>
				)
			}
		</div>
	</section>
</PageLayout>
